# Copy to .env for local development.

# Postgres roles (see docs/architecture.md, "Database roles")
POSTGRES_DB="helpdesk"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
APP_OWNER_PASSWORD="app_owner_dev_password"
APP_USER_PASSWORD="app_user_dev_password"

# Runtime (API and worker) connects as app_user, which cannot bypass RLS.
DATABASE_URL="postgresql://app_user:app_user_dev_password@localhost:5432/helpdesk"
# Prisma Migrate connects as app_owner.
MIGRATE_DATABASE_URL="postgresql://app_owner:app_owner_dev_password@localhost:5432/helpdesk"

REDIS_URL="redis://localhost:6379"

# SeaweedFS (S3-compatible)
S3_ENDPOINT="http://localhost:8333"
S3_ACCESS_KEY="helpdesk"
S3_SECRET_KEY="helpdesk_dev_password"
S3_BUCKET="helpdesk-attachments"

# Mailpit
SMTP_HOST="localhost"
SMTP_PORT=1025
