{
  "name": "@helpdesk/prisma",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@helpdesk/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "scope:data"
    ],
    "targets": {
      "prisma-generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma"
        ],
        "options": {
          "command": "pnpm prisma generate",
          "cwd": "{projectRoot}"
        }
      },
      "build": {
        "dependsOn": [
          "prisma-generate"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "prisma-generate"
        ]
      },
      "test": {
        "dependsOn": [
          "prisma-generate"
        ]
      },
      "lint": {
        "dependsOn": [
          "prisma-generate"
        ]
      }
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "@prisma/client": "^6.19.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
